    13                              <1> ; File: macro.inc
    14                              <1> ; Purpose: Provide the activation-record macros used to preserve and restore the
    15                              <1> ;          delivery function's general-purpose register environment.
    16                              <1> ; Language: x86-64 assembly
    17                              <1> ; Syntax: Intel
    18                              <1> ; Assembler: NASM
    19                              <1> 
    20                              <1> ; Preserve the delivery driver's general-purpose register environment
    21                              <1> %macro create_activation_record 0
    22                              <1>     push rbp
    23                              <1>     mov  rbp, rsp
    24                              <1>     push rbx
    25                              <1>     push rcx
    26                              <1>     push rdx
    27                              <1>     push rdi
    28                              <1>     push rsi
    29                              <1>     push r8
    30                              <1>     push r9
    31                              <1>     push r10
    32                              <1>     push r11
    33                              <1>     push r12
    34                              <1>     push r13
    35                              <1>     push r14
    36                              <1>     push r15
    37                              <1>     pushf
    38                              <1> %endmacro
    39                              <1> 
    40                              <1> ; Restore the delivery driver's general-purpose register environment
    41                              <1> %macro delete_activation_record 0
    42                              <1>     popf
    43                              <1>     pop r15
    44                              <1>     pop r14
    45                              <1>     pop r13
    46                              <1>     pop r12
    47                              <1>     pop r11
    48                              <1>     pop r10
    49                              <1>     pop r9
    50                              <1>     pop r8
    51                              <1>     pop rsi
    52                              <1>     pop rdi
    53                              <1>     pop rdx
    54                              <1>     pop rcx
    55                              <1>     pop rbx
    56                              <1>     pop rbp
    57                              <1> %endmacro
